# SPA fallback: let React Router handle all client-side routes.
# Without this, any direct hit on a route like /account or /cart
# (fresh visit, refresh, bookmark) 404s at the Apache level before
# index.html ever loads.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files/directories as-is (assets, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls back to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Fallback 404 handler in case mod_rewrite is unavailable
ErrorDocument 404 /index.html
