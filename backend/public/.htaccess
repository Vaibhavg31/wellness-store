RewriteEngine On

# Block direct access to dotfiles (.env, .git, etc.) and common non-web artifacts
<FilesMatch "^\.|\.(env|sql|log|zip|md)$">
    Require all denied
</FilesMatch>

# Serve existing files directly (uploads, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route everything else to index.php
RewriteRule ^ index.php [L]
